# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
# Must list the exact scheme+host of every frontend origin allowed to call this API
# (also feeds CSRF_TRUSTED_ORIGINS, see plane/settings/common.py). If the frontend is
# deployed on a different domain than this API (e.g. Vercel + Render), the frontend's
# real https:// origin(s) MUST be listed here or every cross-site POST will 403 with
# a CSRF failure.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# When the frontend and this API are on different domains (cross-site deployment),
# cookies must use SameSite=None so the browser sends them back on cross-site
# requests; SameSite=None is only honored by browsers when Secure is also set, which
# happens automatically in plane/settings/common.py whenever these are "None".
# Leave unset (defaults to "Lax") for same-origin/proxied deployments.
# SESSION_COOKIE_SAMESITE="None"
# CSRF_COOKIE_SAMESITE="None"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Groq API key, used for AI Voice-to-Ticket (Whisper transcription + Llama ticket generation)
GROQ_API_KEY=""

# Email (Brevo)
# All transactional email (forgot password, invitations, magic links, notifications,
# webhook alerts, exports) is sent over Brevo's HTTPS API, not SMTP - several hosts
# this app runs on block outbound SMTP ports, so SMTP just hangs. See
# plane/utils/email_provider.py for details.
#
# BREVO_API_KEY must be your Brevo **API key** (starts with "xkeysib-"), found under
# Brevo > SMTP & API > API Keys. This is NOT the same credential as your Brevo SMTP
# key/password - they are not interchangeable, and using the SMTP key here will fail
# every send with an authentication error.
BREVO_API_KEY=""

# IMPORTANT: EMAIL_FROM (sender name + address) is NOT read from this env var by
# default. SKIP_ENV_VAR defaults to "1" (see plane/settings/common.py), which means
# get_configuration_value() reads from the InstanceConfiguration DB table instead of
# the environment. You must set the sender address in
# God mode -> Instance settings -> Email -> "Sender's email address" after first
# deploy, or emails will fall back to the default "Team Plane <team@mailer.plane.so>"
# sender and Brevo will reject the send if that address isn't verified on your account.
#
# The "Host" field on that same God mode form only needs to be non-empty (e.g.
# "api.brevo.com") to mark email as configured for the forgot-password flow - it is
# not actually used to connect anywhere. Port/Username/Password/TLS/SSL on that form
# are unused leftovers from the old SMTP path.
EMAIL_FROM="Team Plane <team@mailer.plane.so>"
